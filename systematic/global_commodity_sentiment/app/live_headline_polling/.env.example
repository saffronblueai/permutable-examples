# ── Permutable AI API ─────────────────────────────────────────────────────────
API_KEY=your-permutable-api-key-here
BASE_URL=https://copilot-api.permutable.ai/v1

# ── GCSI headline feed. The ticker is the ticker_preset query parameter. ──────
FEED_LIVE_PATH=/headlines/feed/live/gcsi
FEED_HISTORICAL_PATH=/headlines/feed/historical/gcsi

# ── Series to poll ─────────────────────────────────────────────────────────────
# Comma-separated commodity tickers included in your licence
TICKERS=BZ_COM
# MATCH_TYPES: empty uses the API default COMBINED; or any of EXPLICIT, RELATED_ENTITY, MACROECONOMIC
MATCH_TYPES=

# ── Polling ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=900
BACKFILL_DAYS=3

# ── Storage ────────────────────────────────────────────────────────────────────
DB_PATH=/data/gcsi_headlines.db

# ── Own aggregation ────────────────────────────────────────────────────────────
# Bins are built on processed_at (receipt) and labelled by their end, like the hourly index
BIN_MINUTES=15
SMOOTHING_HOURS=6
MIN_HEADLINES=5
MIN_TOPIC_PROBABILITY=0.0

# ── Dashboard ──────────────────────────────────────────────────────────────────
API_URL=http://api:8000
REFRESH_INTERVAL_MS=60000
DASHBOARD_HOURS=48
