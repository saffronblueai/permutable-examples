# ── Permutable AI API ─────────────────────────────────────────────────────────
API_KEY=your-permutable-api-key-here
BASE_URL=https://copilot-api.permutable.ai/v1

# ── GCSI index routes. The ticker is the ticker_preset query parameter. ───────
INDEX_LIVE_PATH=/headlines/index/gcsi/live
INDEX_HISTORICAL_PATH=/headlines/index/gcsi/historical

# ── Series to poll ─────────────────────────────────────────────────────────────
# Comma-separated commodity tickers included in your licence (Brent, WTI, TTF gas, copper)
TICKERS=BZ_COM,CL_COM,TFM_COM,QC_COM
# INDEX_TYPES: any of COMBINED, EXPLICIT, RELATED_ENTITY, MACROECONOMIC
INDEX_TYPES=COMBINED
# SENTIMENT_TYPES: any of short_term, medium_term, long_term
SENTIMENT_TYPES=short_term,medium_term,long_term

# ── Polling ────────────────────────────────────────────────────────────────────
# One request per ticker, index type and horizon, with topic_preset=ALL.
POLL_INTERVAL_SECONDS=900
BACKFILL_DAYS=30
REVISION_HOURS=6

# ── Storage ────────────────────────────────────────────────────────────────────
DB_PATH=/data/gcsi_index.db

# ── Indicator ──────────────────────────────────────────────────────────────────
# sentiment_smooth = Σ sentiment_sum / Σ headline_count over SMOOTHING_HOURS
SMOOTHING_HOURS=24
MIN_HEADLINES=5
# percentile: thresholds calibrated per ticker and horizon over CALIBRATION_HOURS
# fixed: use UPPER_THRESHOLD / LOWER_THRESHOLD
THRESHOLD_MODE=percentile
UPPER_PERCENTILE=0.90
LOWER_PERCENTILE=0.10
UPPER_THRESHOLD=0.15
LOWER_THRESHOLD=-0.15
CALIBRATION_HOURS=720

# ── Dashboard ──────────────────────────────────────────────────────────────────
API_URL=http://api:8000
REFRESH_INTERVAL_MS=60000
DASHBOARD_HOURS=168
