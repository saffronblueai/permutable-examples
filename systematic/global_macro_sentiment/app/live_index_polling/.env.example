# ── Permutable AI API ─────────────────────────────────────────────────────────
API_KEY=your-permutable-api-key-here
BASE_URL=https://copilot-api.permutable.ai/v1

# ── Countries ──────────────────────────────────────────────────────────────────
# Comma-separated ISO-2 country codes. Get valid codes from GET /v1/countries.
# This default set matches the README dashboard screenshot.
COUNTRIES=US,JP,IT,GB,FR,DE,CA

# ── Topics ─────────────────────────────────────────────────────────────────────
# Comma-separated full GMSI topic names. Get valid names from GET /v1/headlines/topics/gmsi.
# This default set matches the README dashboard screenshot.
TOPICS=Monetary Policy-Policy Tools-Interest Rates,Economic Data-Inflation-Energy,Economic Data-Inflation-Food,Fiscal Policy-Fiscal Stance

# ── Index configuration ────────────────────────────────────────────────────────
# INDEX_TYPES: COMBINED | DOMESTIC | INTERNATIONAL (comma-separated)
INDEX_TYPES=COMBINED

# SENTIMENT_TYPES: directional | semantic_sentiment (comma-separated)
# Both are fetched by default so the dashboard can compare the two signals.
SENTIMENT_TYPES=directional,semantic_sentiment

# sparse=true returns only hourly buckets that contain headlines (recommended)
SPARSE=true
# align_to_period_end=true timestamps each bucket at the close of the hour
ALIGN_TO_PERIOD_END=true

# ── Polling ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=900
BACKFILL_DAYS=7

# ── Storage ────────────────────────────────────────────────────────────────────
DB_PATH=/data/gmsi_index.db

# ── Sentiment thresholds ───────────────────────────────────────────────────────
# sentiment_avg = sentiment_sum / headline_count ∈ [−1, +1]
UPPER_THRESHOLD=0.5
LOWER_THRESHOLD=-0.5

# ── Dashboard ──────────────────────────────────────────────────────────────────
API_URL=http://api:8000
REFRESH_INTERVAL_MS=60000
