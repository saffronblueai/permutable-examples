# ── Permutable AI API ─────────────────────────────────────────────────────────
API_KEY=your-permutable-api-key-here
BASE_URL=https://copilot-api.permutable.ai/v1

# ── Countries ──────────────────────────────────────────────────────────────────
# Comma-separated ISO-2 country codes. Get valid codes from GET /v1/countries.
# This default set matches the README dashboard screenshot.
COUNTRIES=US,JP,IT,GB,FR,DE,CA

# ── Topics ─────────────────────────────────────────────────────────────────────
# Comma-separated full GMSI topic names. Get valid names from GET /v1/headlines/topics/gmsi.
# This default set matches the README dashboard screenshot.
# Use the full hierarchical name exactly as returned by the taxonomy endpoint.
# Example topics: "Monetary Policy-Policy Tools-Interest Rates", "Economic Data-Inflation"
TOPICS=Monetary Policy-Policy Tools-Interest Rates,Economic Data-Inflation-Energy,Economic Data-Inflation-Food,Fiscal Policy-Fiscal Stance

# ── Feed configuration ─────────────────────────────────────────────────────────
# MATCH_TYPE: DOMESTIC | INTERNATIONAL | COMBINED
MATCH_TYPE=COMBINED

# ── Polling ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=900
BACKFILL_DAYS=7

# ── Storage ────────────────────────────────────────────────────────────────────
DB_PATH=/data/gmsi_headlines.db

# ── Signal thresholds ──────────────────────────────────────────────────────────
# directional_score ∈ [−1, +1]. Tighter defaults because raw headline scores
# carry more noise than hourly aggregates.
UPPER_THRESHOLD=0.1
LOWER_THRESHOLD=-0.1

# ── Dashboard ──────────────────────────────────────────────────────────────────
API_URL=http://api:8000
REFRESH_INTERVAL_MS=60000
